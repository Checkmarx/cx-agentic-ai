{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "com.checkmarx/Checkmarx",
  "description": "Official Checkmarx MCP Server",
  "repository": {
    "url": "https://github.com/Checkmarx/cx-agentic-ai",
    "source": "github"
  },
  "version": "1.0.0",
  "websiteUrl": "https://docs.checkmarx.com/en/34965-591689-1-mcp-server---interacting-with-checkmarx-via-ai-assistant.html#UUID-040840ae-8e9d-1025-c148-afe2bd11d370",
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://{cxone_base_url}/api/security-mcp/mcp/{tenant_id}",
      "variables": {
        "cxone_base_url": {
          "description": "API host provided by your Checkmarx administrator, e.g., ast.checkmarx.net",
          "isRequired": true
        },
        "tenant_id": {
          "description": "Tenant identifier (e.g., 'cx_eu', 'checkmarx')",
          "isRequired": true
        }
      }
    }
  ],
  "authentication": {
    "methods": [
      {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization",
        "description": "API key issued by Checkmarx"
      },
      {
        "type": "oauth2"
      }
    ]
  }
}
