{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.checkmarx/security-mcp",
  "description": "The Checkmarx MCP Server provides the vulnerability remediation and Checkmarx service platform tools",
  "repository": {
    "url": "https://github.com/Checkmarx/cx-agentic-ai",
    "source": "github"
  },
  "version": "1.0.0",
  "websiteUrl": "https://checkmarx.com/product/developer-assist/",
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://{api_host}/api/security-mcp/mcp/{tenant_id}",
      "variables": {
		 "api_host": {
          "description": "API host provided by your Checkmarx administrator, e.g., ast.checkmarx.net",
          "isRequired": true
        },
        "tenant_id": {
          "description": "Tenant identifier (e.g., 'cx_eu', 'checkmarx')",
          "isRequired": true
        }
      }
    }
  ],
	"authentication": {
	  "methods": [
		{
		  "type": "apiKey",
		  "in": "header",
		  "name": "Authorization",
		  "description": "API key issued by Checkmarx"
		},
		{
		  "type": "oauth2"
		}
	  ]
	}
}