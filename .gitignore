# Local credentials — never commit a configured mcp.json with real secrets
mcp/mcp.json.local
*.local

# Python bytecode — the plugins' hook modules get compiled whenever a hook fires, and shipping
# stale bytecode alongside the shipped .py sources would be worse than useless.
__pycache__/
*.py[cod]

# IDE settings
.vscode/settings.json
.vscode/*.code-workspace
.vscode/.checkmarxIgnored
.idea/
*.swp
*.swo
*~

# Claude Code local config
.claude/settings.local.json

# OS metadata
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Python
__pycache__/
*.pyc

# Temporary and log files
*.log
*.tmp
