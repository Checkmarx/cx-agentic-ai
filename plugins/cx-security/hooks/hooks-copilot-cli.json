{
  "version": 1,
  "hooks": {
    "Stop": [
      {
        "type": "command",
        "command": "cx hooks copilot-cli-stop",
        "timeoutSec": 60
      }
    ],
    "preToolUse": [
      {
        "matcher": "bash",
        "type": "command",
        "command": "bash ./hooks/cx_check.sh",
        "timeoutSec": 60
      },
      {
        "matcher": "bash",
        "type": "command",
        "command": "cx hooks copilot-cli-pre-tool-use",
        "timeoutSec": 60
      },
      {
        "matcher": "powershell",
        "type": "command",
        "command": "bash ./hooks/cx_check.sh",
        "timeoutSec": 60
      },
      {
        "matcher": "powershell",
        "type": "command",
        "command": "cx hooks copilot-cli-pre-tool-use",
        "timeoutSec": 60
      },
      {
        "matcher": "create",
        "type": "command",
        "command": "bash ./hooks/cx_check.sh",
        "timeoutSec": 60
      },
      {
        "matcher": "create",
        "type": "command",
        "command": "cx hooks copilot-cli-pre-file-write",
        "timeoutSec": 60
      },
      {
        "matcher": "edit",
        "type": "command",
        "command": "bash ./hooks/cx_check.sh",
        "timeoutSec": 60
      },
      {
        "matcher": "edit",
        "type": "command",
        "command": "cx hooks copilot-cli-pre-file-write",
        "timeoutSec": 60
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": ".*",
        "type": "command",
        "command": "cx hooks copilot-cli-user-prompt-submit",
        "timeoutSec": 60
      }
    ]
  }
}
