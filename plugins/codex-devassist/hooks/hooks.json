{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${PLUGIN_ROOT}/hooks/cx_check.sh\" --codex",
            "timeout": 45,
            "statusMessage": "Checking cx CLI is available..."
          },
          {
            "type": "command",
            "command": "sh \"${PLUGIN_ROOT}/hooks/cx_run.sh\" hooks codex-pre-tool-use",
            "timeout": 10,
            "statusMessage": "Checking command against security policy..."
          }
        ]
      },
      {
        "matcher": "apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${PLUGIN_ROOT}/hooks/cx_check.sh\" --codex",
            "timeout": 45,
            "statusMessage": "Checking cx CLI is available..."
          },
          {
            "type": "command",
            "command": "sh \"${PLUGIN_ROOT}/hooks/cx_run.sh\" hooks codex-pre-file-write",
            "timeout": 60,
            "statusMessage": "Checking file write against security policy..."
          }
        ]
      },
      {
        "matcher": "mcp__Checkmarx__.*",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${PLUGIN_ROOT}/hooks/cx_check.sh\" --codex",
            "timeout": 45,
            "statusMessage": "Checking cx CLI is available..."
          },
          {
            "type": "command",
            "command": "sh \"${PLUGIN_ROOT}/hooks/cx_run.sh\" hooks codex-pre-tool-use",
            "timeout": 10,
            "statusMessage": "Checking MCP tool call against security policy..."
          }
        ]
      }
    ]
  }
}
