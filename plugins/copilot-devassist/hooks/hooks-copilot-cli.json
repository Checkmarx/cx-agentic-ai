{
  "version": 1,
  "disableAllHooks": false,
  "hooks": {
    "preToolUse": [
      {
        "matcher": "powershell|bash|shell",
        "type": "command",
        "command": "sh \"$HOME/.copilot/installed-plugins/cx-devassist-marketplace/cx-devassist/hooks/cx_record_login.sh\"",
        "timeoutSec": 60,
        "statusMessage": "Noting Checkmarx environment...",
        "env": {"CX_ASSISTANT": "copilot-cli"}
      },
      {
        "matcher": "create|edit",
        "type": "command",
        "command": "sh \"$HOME/.copilot/installed-plugins/cx-devassist-marketplace/cx-devassist/hooks/cx_check.sh\" --copilot-cli",
        "timeoutSec": 45,
        "statusMessage": "Checking cx CLI is available...",
        "env": {"CX_ASSISTANT": "copilot-cli"}
      },
      {
        "matcher": "create|edit",
        "type": "command",
        "command": "sh \"$HOME/.copilot/installed-plugins/cx-devassist-marketplace/cx-devassist/hooks/cx_run.sh\" hooks copilot-cli-pre-file-write",
        "timeoutSec": 60,
        "statusMessage": "Checking file write against security policy...",
        "env": {"CX_ASSISTANT": "copilot-cli"}
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "sh \"$HOME/.copilot/installed-plugins/cx-devassist-marketplace/cx-devassist/hooks/cx_run.sh\" hooks copilot-cli-stop",
        "timeoutSec": 60,
        "env": {"CX_ASSISTANT": "copilot-cli"}
      }
    ]
  }
}
