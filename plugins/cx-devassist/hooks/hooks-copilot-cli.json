{
  "version": 1,
  "hooks": {
    "preToolUse": [
      {
        "matcher": "create",
        "type": "command",
        "command": "cx hooks copilot-cli-pre-file-write",
        "timeoutSec": 60
      },
      {
        "matcher": "edit",
        "type": "command",
        "command": "cx hooks copilot-cli-pre-file-write",
        "timeoutSec": 60
      }
    ]
  }
}
