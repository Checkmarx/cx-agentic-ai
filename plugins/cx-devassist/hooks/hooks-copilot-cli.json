{
  "version": 1,
  "disableAllHooks": false,
  "hooks": {
    "preToolUse": [
      {
        "matcher": "create|edit|powershell|bash|shell",
        "type": "command",
        "command": "sh \"$HOME/.copilot/installed-plugins/cx-devassist-marketplace/cx-devassist/hooks/cx_check.sh\" --copilot-cli",
        "timeoutSec": 45,
        "statusMessage": "Checking cx CLI is available..."
      },
      {
        "matcher": "create|edit",
        "type": "command",
        "command": "sh \"$HOME/.copilot/installed-plugins/cx-devassist-marketplace/cx-devassist/hooks/cx_run.sh\" hooks copilot-cli-pre-file-write",
        "timeoutSec": 60,
        "statusMessage": "Checking file write against security policy..."
      }
    ]
  }
}
