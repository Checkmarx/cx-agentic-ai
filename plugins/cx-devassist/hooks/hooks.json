{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/cx_record_login.sh\"",
            "timeout": 10,
            "statusMessage": "Noting Checkmarx environment..."
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/cx_check.sh\"",
            "timeout": 45,
            "statusMessage": "Checking cx CLI is available..."
          },
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/cx_run.sh\" hooks claude-pre-file-write",
            "timeout": 60,
            "statusMessage": "Checking file write against security policy..."
          }
        ]
      },
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/cx_check.sh\"",
            "timeout": 45,
            "statusMessage": "Checking cx CLI is available..."
          },
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/cx_run.sh\" hooks claude-pre-file-write",
            "timeout": 60,
            "statusMessage": "Checking file edit against security policy..."
          }
        ]
      },
      {
        "matcher": "MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/cx_check.sh\"",
            "timeout": 45,
            "statusMessage": "Checking cx CLI is available..."
          },
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/cx_run.sh\" hooks claude-pre-file-write",
            "timeout": 60,
            "statusMessage": "Checking file write against security policy..."
          }
        ]
      },
      {
        "matcher": "mcp__Checkmarx__.*",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/cx_check.sh\"",
            "timeout": 45,
            "statusMessage": "Checking cx CLI is available..."
          },
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/cx_run.sh\" hooks claude-pre-tool-use",
            "timeout": 10,
            "statusMessage": "Checking MCP tool call against security policy..."
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/cx_session_start.sh\"",
            "timeout": 20,
            "statusMessage": "Checking Checkmarx session posture..."
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/cx_run.sh\" hooks claude-stop",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
